# Copiá este archivo como .env (opcional). Todas las variables tienen un valor por defecto.

# Puerto del servidor
PORT=5173

# Carpeta PERSISTENTE para la base de inscripciones (SQLite). En producción: un volumen persistente.
DATA_DIR=data

# Carpeta PRIVADA con los audios reales (nunca pública). En producción: volumen persistente.
AUDIO_DIR=server/private-audio

# true = si falta un audio real, usar el de prueba (marcado como "AUDIO DE PRUEBA").
# Para el lanzamiento real: false (si falta un archivo, esa canción da error en vez de sonar un demo).
DEMO_AUDIO=true

# true si el servidor está detrás de un proxy/CDN (para el límite de intentos por IP).
TRUST_PROXY=false

# SOLO DESARROLLO (se ignora en producción): closed | open | in:30 | 2026-11-20T21:00:00-03:00
# DEV_RELEASE=in:30
